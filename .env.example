# Copy to .env.local for local overrides. Do not commit real secrets.

# Required at runtime on Vercel Production and Preview.
# Leave unset for local `next dev` and tests (dev-only fallback).
# Changing this value resets rate-limit and cache keys.
HASH_SALT=

# Required for live checks and Blob-backed cache.
OPENAI_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Optional. Defaults are in README.md.
# PER_IP_DAILY=3
# GLOBAL_DAILY=25
# LAUNCH_DAYS=2026-11-10,2026-11-11,2026-11-12
# LAUNCH_DAILY=150
# MONTHLY_BUDGET_USD=10
# LAUNCH_MONTH=2026-11
# LAUNCH_MONTHLY_BUDGET_USD=20
# EST_COST_PER_CHECK=0.12
# EST_COST_PER_LOOKUP=0.12
# November 2026 is hard-capped at $50 in lib/limits.js. Production sets LAUNCH_MONTHLY_BUDGET_USD=50.
# SHOW_COST=1
# Report email stays off until all three are set. RESEND_FROM must be on a domain already verified in Resend.
# EMAIL_CAPTURE_ENABLED=1
# RESEND_API_KEY=
# RESEND_FROM=AI Visibility Checker <reports@your-verified-domain>
# One-time $19 report stays hidden unless this is exactly 1. Do not turn it on without approval.
# PAID_REPORT_ENABLED=1
# Monthly tracking ($24/month) stays hidden unless this is exactly 1.
# Checkout reads STRIPE_SECRET_KEY and STRIPE_TRACKING_PRICE_ID. The webhook reads STRIPE_WEBHOOK_SECRET.
# The weekly cron reads CRON_SECRET. Re-checks use TRACKING_MONTHLY_BUDGET_USD (default 10), separate from the free checker.
# TRACKING_TIER_ENABLED=1
# STRIPE_SECRET_KEY=
# STRIPE_TRACKING_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
# CRON_SECRET=
# TRACKING_MONTHLY_BUDGET_USD=10
